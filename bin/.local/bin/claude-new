#!/usr/bin/env bash
set -e

CONVOS_DIR="${CLAUDE_CONVOS_DIR:-$HOME/claude-convos}"
CONVOS_SUBDIR="$CONVOS_DIR/convos"
SESSIONS_DIR="$CONVOS_DIR/sessions"

mkdir -p "$CONVOS_SUBDIR" "$SESSIONS_DIR"

# Compose message
TEMP_MSG=$(mktemp --suffix=.md)
cat > "$TEMP_MSG" << 'EOF'
# Your Question

EOF

nvim "$TEMP_MSG"

if [ ! -s "$TEMP_MSG" ]; then
    rm "$TEMP_MSG"
    exit 0
fi

MESSAGE=$(tail -n +3 "$TEMP_MSG")
rm "$TEMP_MSG"

if [ -z "$MESSAGE" ]; then
    echo "No message entered"
    exit 0
fi

# Create new session ID
SESSION_ID=$(uuidgen)

# Ask Claude with new session
echo ""
echo "Asking Claude..."
RESPONSE=$(claude --session-id "$SESSION_ID" --dangerously-skip-permissions "$MESSAGE" 2>&1)

# Create new file
TIMESTAMP=$(date +%Y-%m-%d-%H%M%S)
TITLE=$(echo "$MESSAGE" | head -1 | cut -c 1-30 | tr ' ' '-' | tr -cd '[:alnum:]-')
NEW_FILE="$CONVOS_SUBDIR/${TIMESTAMP}-${TITLE}.md"
BASENAME=$(basename "${NEW_FILE%.md}")
SESSION_FILE="$SESSIONS_DIR/${BASENAME}.session"

# Save session ID
echo "$SESSION_ID" > "$SESSION_FILE"

# Create markdown file
cat > "$NEW_FILE" << EOF
# Claude Conversation
*Started: $(date '+%Y-%m-%d %H:%M:%S')*
*Session: $SESSION_ID*

---

# 1

**Question:**
$MESSAGE

**Answer:**
$RESPONSE

---

EOF

echo ""
echo "✓ Created: $(basename "$NEW_FILE")"

# Auto-open the file
nvim "$NEW_FILE"

exec $SHELL
