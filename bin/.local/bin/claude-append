#!/usr/bin/env bash
set -e

# Convert to absolute path
CURRENT_FILE="$(readlink -f "$1")"
CONVOS_DIR="${CLAUDE_CONVOS_DIR:-$HOME/claude-convos}"
CONVOS_SUBDIR="$CONVOS_DIR/convos"
SESSIONS_DIR="$CONVOS_DIR/sessions"

BASENAME=$(basename "${CURRENT_FILE%.md}")
SESSION_FILE="$SESSIONS_DIR/${BASENAME}.session"

if [ -z "$CURRENT_FILE" ] || [ ! -f "$CURRENT_FILE" ]; then
    echo "Error: No file provided or file doesn't exist"
    sleep 2
    exit 1
fi

if [[ ! "$CURRENT_FILE" =~ \.md$ ]]; then
    echo "Error: Not a markdown file"
    sleep 2
    exit 1
fi

# Check for session file
if [ ! -f "$SESSION_FILE" ]; then
    echo "Error: No session file found at: $SESSION_FILE"
    echo "This file wasn't created with claude-new."
    sleep 3
    exit 1
fi

SESSION_ID=$(cat "$SESSION_FILE")

# Compose message
TEMP_MSG=$(mktemp --suffix=.md)
echo "# Your Question" > "$TEMP_MSG"
echo "" >> "$TEMP_MSG"

nvim "$TEMP_MSG"

MESSAGE=$(sed '1,2d' "$TEMP_MSG")
rm "$TEMP_MSG"

if [ -z "$MESSAGE" ]; then
    exit 0
fi

# Get next question number
NUM=$(grep -oP '^# \K\d+' "$CURRENT_FILE" 2>/dev/null | sort -n | tail -1)
[ -z "$NUM" ] && NUM=0
NUM=$((NUM + 1))

# Ask Claude - RESUME existing session
echo ""
echo "Asking Claude (Session: $SESSION_ID)..."
set +e
RESPONSE=$(claude --resume "$SESSION_ID" --dangerously-skip-permissions "$MESSAGE" 2>&1)
CLAUDE_EXIT=$?
set -e

if [ $CLAUDE_EXIT -ne 0 ]; then
    echo ""
    echo "Error: Claude command failed (exit code: $CLAUDE_EXIT)"
    echo "Session ID: $SESSION_ID"
    echo ""
    echo "Response:"
    echo "$RESPONSE"
    echo ""
    read -p "Press Enter to continue..."
    exit 1
fi

# Append to file
cat >> "$CURRENT_FILE" << EOF
# $NUM

**Question:**
$MESSAGE

**Answer:**
$RESPONSE

---

EOF

echo ""
echo "✓ Added question #$NUM to $(basename "$CURRENT_FILE")"
sleep 1
